# 依赖与构建产物（lib/ 由 `npm run build` 重新生成，不入库）
node_modules/
lib/
*.tsbuildinfo
*.tgz

# 系统垃圾
.DS_Store
Thumbs.db
npm-debug.log*

# 本地工作文件：不进发布树
AGENTS.md
review/

# 演示视频原片只留本地：README 的内联播放器走 GitHub 附件（见 issue #3），仓库不驮这几十 MB
docs/videos/

# scripts/ 只跟踪构建与体检用到的脚本，其余是本地工具
scripts/*
!scripts/sync-client.mjs
!scripts/check-i18n.mjs
!scripts/check-css-chain.mjs
!scripts/host-deps.mjs
!scripts/doctor.mjs
!scripts/compat-matrix.mjs
!scripts/sync-profile.mjs
!scripts/check-strict.mjs
!scripts/check-css-chain.mjs

# 工具产物
.host-deps-backup/
.playwright-cli/
.playwright-mcp/
.compat-preview.html
.memory-note-preview.html
.persona-preview.html
.trash-preview.html
