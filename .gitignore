node_modules/
npm-debug.log*
*.tsbuildinfo
.DS_Store
Thumbs.db

# Original copies of the @deepseek-ai packages that scripts/host-deps.mjs replaced
# with junctions into the host installation. Machine-specific scratch: restore with
# `node scripts/host-deps.mjs --restore`, never commit.
.host-deps-backup/

.superpowers/
*.tgz

# Local agent rules for this working copy: the verification bar here is
# `npm run build` alone (functional checks happen manually outside the repo),
# so it stays out of the published tree.
AGENTS.md

# Local code-review workspace for this working copy: session reports
# (00_PROGRESS.md … 07_FINAL_REPORT.md) plus the one-off check scripts used
# during review rounds. Review scratch, not a source artifact.
review/

# Build output (regenerated by `npm run build`; `prepublishOnly` builds before
# publish). Not tracked: the committed copy had already drifted from src/ within
# a single commit (see docs/Changelog.md, "Standards 1") —
# a fresh clone must run `npm run build` before use.
lib/

# Local-only release tooling, but keep the build step that npm scripts call:
# `npm run build` / `npm test` run `node scripts/sync-client.mjs`, and tsc never
# writes lib/client.js on its own — ignoring it breaks a fresh clone's build.
# `check-i18n.mjs` is also kept: `npm test` runs it to catch zh/en key drift.
# `host-deps.mjs` / `doctor.mjs` are kept because `npm run check:host` and the
# upgrade procedure in docs/Changelog.md call them from a fresh clone.
# `sync-profile.mjs` is kept for the same reason: `npm run sync:profile` calls
# it, and it is the documented step for pushing a build into a `file:`-installed
# profile (0.9.0 changelog). Leaving it untracked meant a fix to it could not
# reach the repo — including the 2026-09-17 one that made every mirrored file a
# hard link instead of a copy.
scripts/*
!scripts/sync-client.mjs
!scripts/check-i18n.mjs
!scripts/host-deps.mjs
!scripts/doctor.mjs
!scripts/sync-profile.mjs

# Legacy runtime location inside the plugin directory: the archived-session
# ledger, the retention setting and the seeded AGENTS.md presets all used to be
# written here, and reading user data out of a plugin directory loses it on every
# `dsh plugin update` (the directory is replaced wholesale). Everything now lives
# in `$DSH_HOME/tool-management/`, and startup moves any leftover file in (moved,
# never overwritten). Kept ignored so the empty shell never lands in the repo.
data/

# Submission entry for awesome-dsh-plugin; the canonical copy lives in that
# repository under data/plugins/.
ouli-1242__dsh-plugin-tool-management.yml

# Ad-hoc GitHub API dumps captured while debugging CI (e.g. `gh api .../check-runs`).
# Never a source artifact — keep them out of the repo.
cr.json

# Playwright MCP CLI session dumps (page snapshots / console logs) written into the
# project by the `playwright-cli` tool during UI checks. Test scratch, not source.
.playwright-cli/
# The same scratch, written by the `playwright` MCP server instead of the CLI.
.playwright-mcp/

# Compat-page layout preview written by `scripts/preview-compat.mjs` (its default
# output; that script's own comment already promised this ignore rule).
.compat-preview.html
# Scene-memory notice preview written by `scripts/preview-memory-note.mjs`.
.memory-note-preview.html
# Persona role-frame preview written by `scripts/preview-persona.mjs`.
.persona-preview.html

